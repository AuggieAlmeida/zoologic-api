APP_NAME=MyAPI
APP_ENV=development
APP_DEBUG=true

# Port the built-in PHP server binds. Managed platforms set this themselves.
PORT=8000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=zoologicdb
DB_USER=root
DB_PASS=

# Set to true when the database is provisioned by the platform: the migration
# then only creates tables and never issues CREATE DATABASE.
DB_MANAGED=false

# Managed MySQL requires TLS, and TLS is enabled by DB_SSL_CA alone: without a
# CA attribute the MySQL client negotiates a plaintext connection. For a
# provider signed by a public CA, such as TiDB Cloud, the system bundle of the
# php:8.2-cli image is enough:
#   DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# Leave it empty for a database reached over a private network.
DB_SSL_CA=
DB_SSL_VERIFY=true

# Run the migration on boot. Turn it off to start the API without touching the
# schema.
RUN_MIGRATIONS=true

# Exact origins allowed to send credentialed requests, comma separated. The
# wildcard is not usable here because the front end sends credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000

JWT_SECRET=your_secret_key
